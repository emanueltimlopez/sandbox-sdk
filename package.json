{
  "name": "@liquid.code/sandbox-sdk",
  "version": "0.1.4",
  "description": "Small SDK for creating and running Docker-backed sandboxes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pack:dry": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "keywords": [
    "sandbox",
    "docker",
    "sdk"
  ],
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dockerode": "^4.0.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.38",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
